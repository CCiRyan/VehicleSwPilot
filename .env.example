OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
PILOT_AUTH_TOKEN=change-this-local-development-token
PILOT_SOFTWARE_TOKEN=
PILOT_SYSTEM_TOKEN=
PILOT_TEST_TOKEN=

# Compatible gateway: leave base URLs empty to use OpenAI.
OPENAI_BASE_URL=
PILOT_CHAT_BASE_URL=
PILOT_CHAT_API_KEY=
PILOT_EMBEDDING_BASE_URL=
PILOT_EMBEDDING_API_KEY=
PILOT_EMBEDDING_DIMENSIONS=
PILOT_MODEL_TIMEOUT=90
PILOT_STRUCTURED_METHOD=function_calling

# Optional local Docker C executor; image must already exist locally.
PILOT_ENABLE_CONTAINER_EXECUTION=0
PILOT_EXECUTION_IMAGE=gcc:14
